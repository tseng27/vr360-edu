# 208 沉浸式探索教室：環境變數範本
# 複製成 .env.local（本機）或設定在部署平台。這些值都會被打包進前端，只能放「公開」資訊。
# ❌ 絕對不要放：Supabase secret / service_role key、Google token、GitHub token。
#    （前端偵測到 sb_secret_ 或 service_role JWT 會直接拒絕啟動）

# 模組開關：false 時 /classroom 全部顯示「未啟用」，不影響原本的 360 專案平台
NEXT_PUBLIC_CLASSROOM_ENABLED=true

# mock = 同一台電腦多個視窗測試（預設）；supabase = 跨裝置即時同步
NEXT_PUBLIC_CLASSROOM_BACKEND=mock

# 只有 supabase 模式需要（Supabase 後台 → Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 部署在子路徑時（例如 https://<帳號>.github.io/vr360-edu）
NEXT_PUBLIC_BASE_PATH=
